{
  // Static-assets-only Worker for the Astro build. No script runs for page
  // requests, so static asset traffic is free and does not consume the Workers
  // free-plan request quota (error 1027).
  //
  // Legacy /blog?page=N pagination is 301'd by Cloudflare Single Redirect rules
  // in the dashboard (http_request_dynamic_redirect phase), because Workers
  // static assets cannot match query strings in `_redirects`.
  //
  // Used by Cloudflare Workers Builds: `npx wrangler deploy` from site/
  "name": "yieldwatch-io",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
