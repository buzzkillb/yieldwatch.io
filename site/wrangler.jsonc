{
  // Static assets Worker for the Astro build. `main` only exists to 301 the
  // legacy /blog?page=N pagination URLs (see worker.js); everything else is
  // served from ./dist without touching the script.
  // Used by Cloudflare Workers Builds: `npx wrangler deploy` from site/
  "name": "yieldwatch-io",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/blog"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
