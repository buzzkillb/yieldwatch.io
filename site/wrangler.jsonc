{
  // Static assets-only Worker for the Astro build (no server code).
  // Used by Cloudflare Workers Builds: `npx wrangler deploy` from site/
  "name": "yieldwatch-io",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
