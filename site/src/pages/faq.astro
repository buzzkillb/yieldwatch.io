---
// Native Astro FAQ page. The questions are content data rendered directly by
// Astro, and the FAQPage JSON-LD is generated from the same array so the
// visible answers and the structured data can never drift apart.
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_URL } from '../lib/site';

interface FaqItem {
  question: string;
  answer: string;
  link?: { label: string; href: string };
}

const pageTitle = 'FAQ | Treasury Yield Curve Dashboard';
const pageDescription = 'Frequently asked questions about Treasury yields, the yield curve, how YieldWatch works, and where our data comes from.';
const pageUrl = `${SITE_URL}/faq/`;

const faqs: FaqItem[] = [
  {
    question: 'What does the yield curve tell us?',
    answer: 'The yield curve shows what interest rates look like across different timeframes, from 1-month to 30-year bonds. When longer-term rates are higher than shorter-term rates, that is normal. When it flips and short-term rates are higher than long-term rates, that is called an inversion, and traders watch it closely as a potential recession signal.',
  },
  {
    question: 'Why do Treasury yields matter?',
    answer: 'Treasury yields are essentially the price of money for the entire economy. They influence mortgage rates, car loans, business borrowing costs, and even how much you earn on savings. When yields rise, borrowing gets more expensive. When they fall, it is cheaper.',
  },
  {
    question: 'What do the maturity terms mean?',
    answer: 'The chart shows rates for different timeframes, from 1-month to 30-year. The labels on the x-axis are abbreviations: 4WK means 4-week, 2MO means 2-month, 3MO means 3-month, and so on up to 30YR which means 30-year. Think of it as how long you are lending your money to the government.',
  },
  {
    question: 'What is the difference between a Treasury bond and a Treasury bill?',
    answer: 'It comes down to timeframe. Bills are short term, from 4 weeks to 1 year. Bonds are longer term, from 2 to 30 years. Bills are purchased at a discount and mature at face value. Bonds pay interest twice a year and return the principal at maturity. Most of what you see on the yield curve are notes and bonds, with bills trading on the shorter end.',
  },
  {
    question: 'How do I read the yield curve chart?',
    answer: 'The horizontal axis shows time, from short-term on the left to long-term on the right. The vertical axis shows the interest rate. Each dot is the rate Treasury set for that maturity on that day. The line connects them to show the full curve. The shaded bands behind the line show the year high and year low for each maturity, so you can see where today\'s rate sits within the recent range.',
  },
  {
    question: 'What is the Federal Reserves role in yields?',
    answer: 'The Fed controls short-term rates through monetary policy. When the Fed raises or lowers its target rate, it directly affects the shortest maturities. Longer-term yields are set by the market and reflect expectations about future economic growth and inflation. So the Fed influences the front end, but the market drives the rest of the curve.',
  },
  {
    question: 'How often are Treasury rates updated?',
    answer: 'The U.S. Treasury publishes daily yield data around 3:30 PM ET on business days. We update our dashboard daily shortly after they publish.',
  },
  {
    question: 'What are the daily summaries?',
    answer: 'Each day we run the Treasury yield data through an AI model that writes a plain English summary of what happened. It covers rate movements across the full curve, highlights notable changes, and puts today in context compared to the prior week. Think of it as getting a quick market briefing rather than reading raw numbers.',
  },
  {
    question: 'Can I download the data?',
    answer: 'Yes. The API exposes static snapshots for common ranges plus the full historical record going back to 1990. Fetch a snapshot and filter it locally for specific dates or maturities. Check the',
    link: { label: 'API documentation', href: '/api-docs/' },
  },
  {
    question: 'Where does the yield data come from?',
    answer: 'All rates come directly from the U.S. Treasury Department official daily yield curve publication at treasury.gov. No estimates, no approximations. Just the actual rates Treasury publishes each business day around 3:30 PM ET.',
  },
  {
    question: 'Is the yield data real time?',
    answer: 'The Treasury publishes rates once per business day, typically around 3:30 PM ET. We update our dashboard shortly after they publish. There are no live intraday updates. Just one clean snapshot each day that you can compare against history.',
  },
  {
    question: 'How far back does the history go?',
    answer: 'The Treasury publicly available data goes back to 1990. That is over 35 years of daily yield curve snapshots. You can see how rates have evolved through multiple economic cycles, Federal Reserve tightening and loosening periods, and historical events.',
  },
  {
    question: 'What is the difference between the 10-year and 30-year Treasury?',
    answer: 'The 10-year is the most watched for mortgage rates and economic sentiment. The 30-year is for longer term borrowing and gives a read on long term inflation expectations. The spread between them shows how the market sees the next few decades compared to the next decade.',
  },
  {
    question: 'Why do yields move day to day?',
    answer: 'Yields fluctuate based on economic data like jobs reports and inflation, Federal Reserve comments, global events, and trader sentiment. A big jobs report or Federal Reserve speech can move yields significantly in a single day.',
  },
  {
    question: 'Is this financial advice?',
    answer: 'No. This is just data and AI generated summaries of what the numbers show. We are not making predictions, giving trading recommendations, or explaining what rate movements mean for specific investments. If you need financial advice, talk to a qualified professional.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  url: pageUrl,
  mainEntity: faqs.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.link ? `${item.answer} ${item.link.label} for endpoints and examples.` : item.answer,
    },
  })),
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={pageUrl}
  robots="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  imageAlt="U.S. Treasury Yield Curve Dashboard"
  schema={schema}
  active="faq"
  mainClass="container"
>
  <style is:inline slot="head">
    * { box-sizing: border-box; }
    .page-title { font-size: 2rem; font-weight: 600; margin: 0 0 2rem; background: linear-gradient(135deg, var(--text-primary), var(--accent)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .faq-intro { color: var(--text-secondary); margin: 0 0 2.5rem; font-size: 1.05rem; max-width: 700px; }
    .faq-section { margin-bottom: 2.5rem; }
    .faq-item { margin-bottom: 1.5rem; padding: 1.5rem; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; }
    .faq-question { font-size: 1.1rem; font-weight: 600; color: var(--text-primary); margin: 0 0 0.75rem; }
    .faq-answer { color: var(--text-secondary); line-height: 1.7; margin: 0; }
    .faq-answer a { color: var(--accent); }
    @media (max-width: 768px) {
      main.container { padding: 1rem; }
      .page-title { font-size: 1.5rem; }
      .faq-item { padding: 1rem; }
    }
  </style>

  <h1 class="page-title">Frequently Asked Questions</h1>
  <p class="faq-intro">Common questions about Treasury yields, the yield curve, and how YieldWatch works.</p>

  <div class="faq-section">
    {faqs.map(item => (
      <div class="faq-item">
        <h2 class="faq-question">{item.question}</h2>
        <p class="faq-answer">
          {item.answer}
          {item.link && <> <a href={item.link.href}>{item.link.label}</a> for endpoints and examples.</>}
        </p>
      </div>
    ))}
  </div>
</BaseLayout>
