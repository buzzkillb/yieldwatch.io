---
// Homepage: verbatim port of api/public/index.html with the same server-side
// SEO block the old Bun server injected, plus a patched chart loader that
// reads pre-generated static range files instead of queryable API endpoints.
import { readTemplate, buildSeoBlock, latestDay, replaceOnce, replaceAllOnce } from '../lib/site';

let html = readTemplate('index.html', 'dashboard');

// 1. Server-side SEO block (crawlable plain-text rates for non-JS crawlers).
const latest = latestDay();
if (latest) {
  html = replaceOnce(
    html,
    '<div class="container">',
    `<div class="container">\n    ${buildSeoBlock(latest)}`,
    'homepage SEO block'
  );
}

// 2. Chart data now comes from static range snapshots (regenerated daily).
html = replaceOnce(
  html,
  "const response = await fetch(`/api/rates?from=${from}&to=${to}&limit=${reqLimit}`);",
  `const RANGE_FILES = { '3m': '/api/rates/3m.json', '6m': '/api/rates/6m.json', '1y': '/api/rates/1y.json', '2y': '/api/rates/2y.json', '5y': '/api/rates/5y.json', 'all': '/api/rates/all.json' };
        const response = await fetch(RANGE_FILES[currentRange] || '/api/rates/all.json');`,
  'homepage chart loader'
);

// 3. The dashboard's initial fetch still uses the extensionless documented
// path; point it at the static snapshot so no server-side rewrite is needed
// for the page itself (the _redirects rule remains for external consumers).
html = replaceAllOnce(html, "fetch('/api/rates/latest')", "fetch('/api/rates/latest.json')", 'homepage latest fetch');
---
<Fragment set:html={html} />
