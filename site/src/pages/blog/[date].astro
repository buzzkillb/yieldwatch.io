---
// Blog post pages: full static replica of the old SSR path in api/src/index.ts
// (head meta, JSON-LD, article, prev/next, recent-5 hub, chart) generated per
// date from src/data/summaries.json. The template's client loader is disabled;
// its own renderChart is reused with embedded data.
import {
  readTemplate, escapeHtml, dateFormatted, linkLabel, formatBlogSummary,
  SUMMARIES, CHART_COLORS, SITE_URL, postHeadline, relatedPosts, inlineJson,
} from '../../lib/site';

export function getStaticPaths() {
  return SUMMARIES.map(s => ({ params: { date: s.date } }));
}

const { date } = Astro.params;
const entry = SUMMARIES.find(s => s.date === date)!;
const blogSummary = entry.blogSummary || entry.summary;
const dateStr = dateFormatted(date);
const blogUrl = `${SITE_URL}/blog/${date}/`;
const ogImageUrl = `${SITE_URL}/og-image/${date}.png`;
// Unique, data-driven headline (largest day-over-day move) — replaces the
// templated "{date} | Treasury Yield Daily" title shared by every post.
const headline = postHeadline(date);
const ogTitle = headline; // headline already includes the date label
const articleH1 = headline;

// Keep <title> near the ~60-character SERP limit. The date is already in the
// URL, breadcrumb schema, and visible post header, so drop it from the title.
const stripDateLabel = (h: string) => h.replace(/\s*\([A-Z][a-z]{2} \d{1,2}, \d{4}\)$/, '').trim();
const titleHeadlineRaw = stripDateLabel(headline);

// A handful of days share an identical largest-move headline (for example two
// different years with the same 2-month bill rate). Search engines treat those
// as duplicate titles, so prefix the date on any headline used more than once.
const allBaseTitles = SUMMARIES.map(s => stripDateLabel(postHeadline(s.date)));
const duplicateTitles = new Set(allBaseTitles.filter((t, i) => allBaseTitles.indexOf(t) !== i));
const shortDate = new Date(`${date}T00:00:00Z`).toLocaleDateString('en-US', {
  timeZone: 'UTC', month: 'short', day: 'numeric', year: 'numeric',
});
const titleHeadline = duplicateTitles.has(titleHeadlineRaw)
  ? `${shortDate}: ${titleHeadlineRaw}`
  : titleHeadlineRaw;
const brandSuffix = ' | YieldWatch';
const pageTitle = titleHeadline.length + brandSuffix.length <= 60
  ? `${titleHeadline}${brandSuffix}`
  : titleHeadline.length <= 60
    ? titleHeadline
    : titleHeadline.slice(0, 59).replace(/\s+\S*$/, '') + '…';

// Meta descriptions: trim at a word boundary BEFORE HTML-escaping so entities
// cannot push the rendered description past 160 characters.
const cleanSummary = blogSummary.replace(/\s+/g, ' ').trim();
const descCut = cleanSummary.length > 150
  ? cleanSummary.slice(0, 150).replace(/\s+\S*$/, '') + '…'
  : cleanSummary;
const metaDescription = escapeHtml(descCut);

// Adjacent posts + recent-5 hub (same semantics as the SSR version).
const desc = [...SUMMARIES].map(s => s.date).sort((a, b) => b.localeCompare(a));
const earlierPosts = desc.filter(d => d < date).slice(0, 5);
const laterPosts = desc.filter(d => d > date).sort((a, b) => a.localeCompare(b)).slice(0, 5);

const prevDate = laterPosts[0];   // newer post
const nextDate = earlierPosts[0]; // older post

const related = relatedPosts(date, 8);

const prevNextHtml = (prevDate || nextDate)
  ? `<nav class="post-nav" aria-label="Adjacent daily summaries">
            ${prevDate ? `<a class="post-nav-link" rel="prev" href="/blog/${prevDate}/">&larr; ${escapeHtml(linkLabel(prevDate))}</a>` : '<span class="post-nav-spacer"></span>'}
            ${nextDate ? `<a class="post-nav-link" rel="next" href="/blog/${nextDate}/">${escapeHtml(linkLabel(nextDate))} &rarr;</a>` : '<span class="post-nav-spacer"></span>'}
          </nav>`
  : '';

const recentHtml = related.length > 0
  ? `<section class="related-summaries" aria-label="Related daily summaries">
            <h2 class="related-title">More Treasury yield daily summaries</h2>
            <ul class="related-list">
              ${related.map(p => `<li><a href="/blog/${p.date}/">${escapeHtml(p.headline)}</a></li>`).join('')}
            </ul>
            <p class="related-archive"><a href="/blog/archive/">Browse the complete archive of every daily summary</a></p>
          </section>`
  : '';

const rates = entry.rates;
const ratesHtml = rates.map((r, i) => `
                  <div class="rate-item" style="border-top: 3px solid ${CHART_COLORS[i % CHART_COLORS.length]}">
                    <div class="rate-maturity">${r.maturity}</div>
                    <div class="rate-value">${r.rate.toFixed(2)}%</div>
                  </div>
                `).join('');

const articleContent = `
          <article>
            <header class="post-header">
              <p class="post-date">${dateStr}</p>
              <h1 class="post-title">${escapeHtml(articleH1)}</h1>
            </header>

            <div class="blog-content blog-summary">
              ${formatBlogSummary(blogSummary)}
            </div>

            ${prevNextHtml}

            <section class="chart-section">
              <h2 class="chart-title">Yield Curve</h2>
              <div class="chart-wrapper">
                <canvas id="yieldChart"></canvas>
              </div>
              <div class="rates-grid">
                ${ratesHtml}
              </div>
            </section>

            ${recentHtml}
          </article>
        `;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: headline,
  description: cleanSummary.length > 300
    ? cleanSummary.slice(0, 300).replace(/\s+\S*$/, '') + '…'
    : cleanSummary,
  datePublished: `${date}T20:00:00Z`,
  dateModified: `${date}T20:00:00Z`,
  mainEntityOfPage: { '@type': 'WebPage', '@id': blogUrl },
  image: ogImageUrl,
  author: { '@type': 'Organization', name: 'YieldWatch', url: SITE_URL },
  publisher: {
    '@type': 'Organization',
    name: 'YieldWatch',
    url: SITE_URL,
    logo: { '@type': 'ImageObject', url: `${SITE_URL}/og/og.png` }
  }
};

let html = readTemplate('blog-post.html', 'blog');

// Nav: expose the archive hub from every post page + style for its CTA.
html = html.replace('  </style>', '  .related-archive { margin-top: 1rem; }\n  .related-archive a { color: var(--accent); }\n  </style>');

// Head meta (same replacements as the SSR version).
html = html.replace(/<title[^>]*>.*<\/title>/, `<title id="page-title">${escapeHtml(pageTitle)}</title>`);
html = html.replace(`content="Treasury yield curve daily analysis" id="meta-desc"`, `content="${metaDescription}" id="meta-desc"`);
html = html.replace(`id="og-url" content="https://yieldwatch.io/blog"`, `id="og-url" content="${blogUrl}"`);
html = html.replace(`id="og-title" content="Treasury Yield Daily Summary"`, `id="og-title" content="${escapeHtml(ogTitle)}"`);
html = html.replace(`id="og-description" content="Treasury yield curve daily analysis"`, `id="og-description" content="${metaDescription}"`);
html = html.replace(`id="og-image" content="https://yieldwatch.io/og/og.png"`, `id="og-image" content="${ogImageUrl}"`);
html = html.replaceAll('content="U.S. Treasury Yield Curve Dashboard"', `content="${escapeHtml(`U.S. Treasury yield curve chart for ${dateStr}`)}"`);
html = html.replace(`id="article-date" content=""`, `id="article-date" content="${date}T20:00:00Z"`);
html = html.replace(`id="article-modified" content=""`, `id="article-modified" content="${date}T20:00:00Z"`);
html = html.replace(`id="twitter-url" content="https://yieldwatch.io/blog"`, `id="twitter-url" content="${blogUrl}"`);
html = html.replace(`id="twitter-title" content="Treasury Yield Daily Summary"`, `id="twitter-title" content="${escapeHtml(ogTitle)}"`);
html = html.replace(`id="twitter-description" content="Treasury yield curve daily analysis"`, `id="twitter-description" content="${metaDescription}"`);
html = html.replace(`id="twitter-image" content="https://yieldwatch.io/og/og.png"`, `id="twitter-image" content="${ogImageUrl}"`);
html = html.replace(`id="canonical-url" href="https://yieldwatch.io/blog/"`, `id="canonical-url" href="${blogUrl}"`);

// Breadcrumb schema: parse, update the leaf, then re-serialize so the final
// ListItem points at the post itself instead of the blog index.
const breadcrumbSchemaMatch = html.match(/id="breadcrumb-schema">([\s\S]*?)<\/script>/);
if (breadcrumbSchemaMatch) {
  try {
    const breadcrumb = JSON.parse(breadcrumbSchemaMatch[1]);
    const items = breadcrumb.itemListElement;
    if (Array.isArray(items) && items.length > 0) {
      const leaf = items[items.length - 1];
      leaf.name = `${dateStr} Summary`;
      leaf.item = blogUrl;
    }
    html = html.replace(
      breadcrumbSchemaMatch[0],
      `id="breadcrumb-schema">\n  ${inlineJson(breadcrumb)}\n  </script>`
    );
  } catch (err) {
    console.warn(`Invalid breadcrumb JSON-LD for ${date}:`, err);
  }
}

// Article JSON-LD.
html = html.replace(
  '</head>',
  `<script type="application/ld+json">\n  ${inlineJson(articleSchema)}\n  </script>\n</head>`
);

// Swap the loading placeholder for the pre-rendered article.
html = html.replace(
  '<div id="content">\n      <div class="loading">Loading summary...</div>\n    </div>',
  `<div id="content">${articleContent}</div>`
);

// Disable the client loader; drive the template's own renderChart with embedded data.
html = html.replace(
  '<script src="https://cdn.jsdelivr.net/npm/chart.js@4.6.1/dist/chart.umd.min.js" integrity="sha384-Emf5ZVIUiarAdhkgtqK+5/Z5qIvM6QoVrS+qAVtfyZVuD5lIHrac0me485+Antp0" crossorigin="anonymous"></script>',
  `<script src="https://cdn.jsdelivr.net/npm/chart.js@4.6.1/dist/chart.umd.min.js" integrity="sha384-Emf5ZVIUiarAdhkgtqK+5/Z5qIvM6QoVrS+qAVtfyZVuD5lIHrac0me485+Antp0" crossorigin="anonymous"></script>
  <script>const POST_RATES = ${inlineJson(rates)};</script>`
);
html = html.replace(/\n    loadPost\(\);\n/, `\n    renderChart(POST_RATES, POST_RATES.map((_, i) => CHART_COLORS[i % CHART_COLORS.length]));\n`);
---
<Fragment set:html={html} />
