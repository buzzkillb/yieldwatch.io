---
import BlogList from '../../components/BlogList.astro';
import { blogTotalPages } from '../../lib/site';

export function getStaticPaths() {
  return Array.from({ length: blogTotalPages() - 1 }, (_, i) => ({ params: { page: String(i + 2) } }));
}

const { page } = Astro.params;
---
<BlogList page={parseInt(page!, 10)} />
