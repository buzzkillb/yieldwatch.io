---
import { RATES, SUMMARIES } from '../lib/site';
import { buildFooter, buildHeader, CHROME_STYLE } from '../lib/chrome';
const lastRate = RATES.length ? RATES[RATES.length - 1].date : null;
const lastSummary = SUMMARIES.length ? SUMMARIES[0].date : null;
const html = `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Page Not Found | YieldWatch</title>
  <meta name="robots" content="noindex">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect fill='%236366f1' rx='15' width='100' height='100'/%3E%3Cpath d='M20 70 L35 55 L50 65 L65 40 L80 45' stroke='white' stroke-width='8' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3Ccircle cx='80' cy='45' r='6' fill='white'/%3E%3C/svg%3E">
  <style>
    :root { --bg-primary: #0a0a0f; --bg-secondary: #0f0f18; --bg-card: #16161f; --border-color: #2a2a3a; --text-primary: #f0f0f5; --text-secondary: #a0a0b0; --text-muted: #606070; --accent: #6366f1; --accent-hover: #818cf8; }
    body { background: var(--bg-primary); color: var(--text-primary); font-family: system-ui, -apple-system, sans-serif; margin: 0; text-align: center; min-height: 100vh; display: flex; flex-direction: column; }
    main { flex: 1; display: flex; align-items: center; justify-content: center; flex-direction: column; padding: 2rem; }
    a { color: var(--accent-hover); text-decoration: none; }
    a:hover { text-decoration: underline; }
    h1 { font-size: 4rem; margin: 0; color: var(--accent); }
    p { color: var(--text-secondary); }
  </style>
  ${CHROME_STYLE}
</head>
<body>
  ${buildHeader(null)}
  <main>
    <h1>404</h1>
    <p>That page doesn't exist. Latest data: ${lastRate ?? 'n/a'} &middot; Latest summary: ${lastSummary ?? 'n/a'}</p>
    <p><a href="/">&larr; Back to the dashboard</a> &nbsp;|&nbsp; <a href="/blog">Daily summaries</a></p>
  </main>
  ${buildFooter()}
</body>
</html>`;
---
<Fragment set:html={html} />
