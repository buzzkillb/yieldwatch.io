---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RATES, SITE_URL, SUMMARIES } from '../lib/site';

const lastRate = RATES.length ? RATES[RATES.length - 1].date : null;
const lastSummary = SUMMARIES.length ? SUMMARIES[0].date : null;

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${SITE_URL}/404#webpage`,
  url: `${SITE_URL}/404`,
  name: 'Page Not Found | YieldWatch',
  isPartOf: { '@id': `${SITE_URL}/#site` },
  inLanguage: 'en-US',
};

const pageDescription = 'The page you requested could not be found. Browse the YieldWatch Treasury yield curve dashboard, daily summaries, archive, FAQ, or API documentation.';
---

<BaseLayout
  title="Page Not Found | YieldWatch"
  description={pageDescription}
  canonical={`${SITE_URL}/404`}
  robots="noindex, follow"
  schema={pageSchema}
  bodyClass="page-404"
>
  <style is:inline slot="head">
    body { text-align: center; display: flex; flex-direction: column; }
    main { flex: 1; display: flex; align-items: center; justify-content: center; flex-direction: column; padding: 2rem; }
    a { color: var(--accent-hover); text-decoration: none; }
    a:hover { text-decoration: underline; }
    h1 { font-size: 2rem; margin: 0.25rem 0 1rem; color: var(--text-primary); }
    .error-code { font-size: 4rem; font-weight: 700; margin: 0; color: var(--accent); line-height: 1; }
    p { color: var(--text-secondary); }
  </style>

  <p class="error-code">404</p>
  <h1>Page not found</h1>
  <p>That page doesn't exist. Latest data: {lastRate ?? 'n/a'} &middot; Latest summary: {lastSummary ?? 'n/a'}</p>
  <p><a href="/">&larr; Back to the dashboard</a> &nbsp;|&nbsp; <a href="/blog/">Daily summaries</a> &nbsp;|&nbsp; <a href="/blog/archive/">Full archive</a> &nbsp;|&nbsp; <a href="/faq/">FAQ</a> &nbsp;|&nbsp; <a href="/methodology/">Methodology</a></p>
</BaseLayout>
