---
// Native Astro document shell. Pages provide their body as markup instead of
// assembling a full HTML string, so the head, chrome, and metadata have one
// implementation and are escaped by Astro rather than by hand.
import { buildFooter, buildHeader, CHROME_STYLE, type ChromeActive } from '../lib/chrome';
import { BRAND_OG_ALT, siteSchemaGraph, socialMetaTags } from '../lib/meta';
import { inlineJson } from '../lib/site';
import { BASE_STYLE } from '../lib/tokens';

interface Props {
  title: string;
  description: string;
  canonical: string;
  robots?: string;
  imageAlt?: string;
  schema?: Record<string, unknown> | null;
  active?: ChromeActive;
  bodyClass?: string;
  mainClass?: string;
}

const {
  title,
  description,
  canonical,
  robots = 'index, follow',
  imageAlt = BRAND_OG_ALT,
  schema = null,
  active = null,
  bodyClass = '',
  mainClass = '',
} = Astro.props;

const FAVICON = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect fill='%236366f1' rx='15' width='100' height='100'/%3E%3Cpath d='M20 70 L35 55 L50 65 L65 40 L80 45' stroke='white' stroke-width='8' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3Ccircle cx='80' cy='45' r='6' fill='white'/%3E%3C/svg%3E";
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <Fragment set:html={socialMetaTags({ url: canonical, title, description, imageAlt })} />
    <link rel="icon" type="image/svg+xml" href={FAVICON} />
    <link rel="alternate" type="application/rss+xml" title="Daily Treasury Yield Summaries RSS" href="/feed.xml" />
    {schema && <script is:inline type="application/ld+json" set:html={inlineJson(schema)}></script>}
    <Fragment set:html={siteSchemaGraph()} />
    <Fragment set:html={CHROME_STYLE} />
    <slot name="head" />
    <Fragment set:html={BASE_STYLE} />
  </head>
  <body class={bodyClass || undefined}>
    <Fragment set:html={buildHeader(active)} />
    <main id="main-content" tabindex="-1" class={mainClass || undefined}>
      <slot />
    </main>
    <Fragment set:html={buildFooter()} />
  </body>
</html>
