---
// Native Astro document shell. Pages provide their body as markup instead of
// assembling a full HTML string, so the head, chrome, and metadata have one
// implementation and are escaped by Astro rather than by hand.
import { buildFooter, buildHeader, CHROME_STYLE, type ChromeActive } from '../lib/chrome';
import { BRAND_OG_ALT, siteSchemaGraph, socialMetaTags } from '../lib/meta';
import { inlineJson } from '../lib/site';
import { BASE_STYLE } from '../lib/tokens';

interface Props {
  title: string;
  description: string;
  canonical: string;
  robots?: string;
  imageAlt?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  schema?: Record<string, unknown> | null;
  active?: ChromeActive;
  bodyClass?: string;
  mainClass?: string;
}

const {
  title,
  description,
  canonical,
  robots = 'index, follow',
  imageAlt = BRAND_OG_ALT,
  ogTitle,
  ogDescription,
  ogImage,
  ogImageAlt,
  ogType = 'website',
  schema = null,
  active = null,
  bodyClass = '',
  mainClass = '',
} = Astro.props;

---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <Fragment set:html={socialMetaTags({
      url: canonical,
      title: ogTitle ?? title,
      description: ogDescription ?? description,
      image: ogImage,
      imageAlt: ogImageAlt ?? imageAlt,
      type: ogType,
    })} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0a0a0f" />
    <link rel="alternate" type="application/rss+xml" title="Daily Treasury Yield Summaries RSS" href="/feed.xml" />
    {schema && <script is:inline type="application/ld+json" set:html={inlineJson(schema)}></script>}
    <Fragment set:html={siteSchemaGraph()} />
    <Fragment set:html={CHROME_STYLE} />
    <slot name="head" />
    <Fragment set:html={BASE_STYLE} />
  </head>
  <body class={bodyClass || undefined}>
    <Fragment set:html={buildHeader(active)} />
    <main id="main-content" tabindex="-1" class={mainClass || undefined}>
      <slot />
    </main>
    <Fragment set:html={buildFooter()} />
  </body>
</html>
