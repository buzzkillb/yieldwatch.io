---
// Server-rendered blog list — an upgrade over the old client-only rendering
// (crawlers now see every card), using the verbatim blog.html template,
// styles, and card markup. Year/month filters work client-side over an
// embedded index; pagination is static.
import {
  readTemplate, escapeHtml, truncateWords, inlineJson, SUMMARIES, POSTS_PER_PAGE, postHeadline, blogTotalPages, SITE_URL,
} from '../lib/site';

interface Props { page: number }
const { page } = Astro.props;

const sorted = [...SUMMARIES].sort((a, b) => b.date.localeCompare(a.date));
const totalPages = Math.max(1, Math.ceil(sorted.length / POSTS_PER_PAGE));
const current = Math.min(Math.max(1, page), totalPages);
const items = sorted.slice((current - 1) * POSTS_PER_PAGE, current * POSTS_PER_PAGE);

const blogIndex = sorted.map(s => ({
  date: s.date,
  hasFullPost: Boolean(s.blogSummary && s.blogSummary.length > 0),
  title: escapeHtml(postHeadline(s.date)),
  excerpt: escapeHtml(truncateWords(s.summary || s.blogSummary || '', 200)),
}));

const hrefFor = (p: number) => (p <= 1 ? '/blog/' : `/blog/${p}/`);

let html = readTemplate('blog.html', 'blog');

// rel prev/next for crawlers.
const seoMetaTags: string[] = [];
if (current > 1) seoMetaTags.push(`<link rel="prev" href="${hrefFor(current - 1)}">`);
if (current < totalPages) seoMetaTags.push(`<link rel="next" href="${hrefFor(current + 1)}">`);

// Paginated listing pages were canonicalizing to /blog/, which Search Console
// reports as "Alternate page with proper canonical tag" for every page. Give
// each page its own self-canonical URL, and keep pages 2+ out of the index
// (noindex, follow) so they stay useful crawl paths without diluting the
// index with near-duplicate card lists. Page 1 keeps /blog/ as canonical.
if (current > 1) {
  html = html.replace(
    /<link rel="canonical" href="[^"]*">/,
    `<link rel="canonical" href="${SITE_URL}/blog/${current}/">`
  );
  html = html.replace(
    /<meta name="robots" content="[^"]*">/,
    '<meta name="robots" content="noindex, follow">'
  );
  html = html.replace(
    /<title>[^<]*<\/title>/,
    `<title>Daily Treasury Summaries, Page ${current} | YieldWatch</title>`
  );
  html = html.replace(
    /<meta name="description" content="[^"]*">/,
    `<meta name="description" content="Page ${current} of the YieldWatch archive of daily U.S. Treasury yield curve summaries, with headline moves and verified rates for each business day.">`
  );
}

if (seoMetaTags.length > 0) {
  html = html.replace('</head>', `\n    ${seoMetaTags.join('\n    ')}\n  </head>`);
}

// Breadcrumb schema must end at the canonical URL for this page. Add a
// "Page N" crumb for paginated listings instead of leaving the leaf at /blog/.
for (const scriptMatch of html.matchAll(/<script type="application\/ld\+json">([\s\S]*?)<\/script>/g)) {
  let breadcrumb;
  try { breadcrumb = JSON.parse(scriptMatch[1].trim()); } catch { continue; }
  if (breadcrumb['@type'] !== 'BreadcrumbList') continue;
  const pageUrl = `${SITE_URL}/blog/${current === 1 ? '' : `${current}/`}`;
  const crumbs = breadcrumb.itemListElement;
  if (current === 1) {
    crumbs[crumbs.length - 1].item = pageUrl;
  } else {
    crumbs.push({ '@type': 'ListItem', position: crumbs.length + 1, name: `Page ${current}`, item: pageUrl });
  }
  html = html.replace(
    scriptMatch[0],
    `<script type="application/ld+json">\n${inlineJson(breadcrumb)}\n</script>`
  );
  break;
}

// Server-render the cards.
const cardsHtml = items.map(item => {
  const dateStr = new Date(item.date + 'T00:00:00Z').toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric', year: 'numeric' });
  return `
          <a href="/blog/${item.date}/" class="summary-card-link">
            <article class="summary-card">
              <div class="summary-date">${dateStr}</div>
              <h2 class="summary-card-title">${escapeHtml(postHeadline(item.date))}</h2>
              <div class="analysis-tag">${item.blogSummary && item.blogSummary.length > 0 ? 'Full analysis available' : 'Quick summary'}</div>
              <p class="summary-excerpt">${escapeHtml(item.summary)}</p>
            </article>
          </a>`;
}).join('');

html = html.replace(
  `<div id="content">
        <div class="loading">Loading summaries...</div>
      </div>`,
  `<div id="content"><div class="summaries-list">${cardsHtml}
          </div></div>`
);

// Static pagination + archive hub CTA (crawlable path to every post).
const paginationHtml = totalPages <= 1 ? '' : `<div class="pagination-controls">
        ${current > 1 ? `<a class="page-link" href="${hrefFor(current - 1)}">&larr; Previous</a>` : ''}
        <span class="page-info">Page ${current} of ${totalPages}</span>
        ${current < totalPages ? `<a class="page-link" href="${hrefFor(current + 1)}">Next &rarr;</a>` : ''}
      </div>`;
html = html.replace(
  '<div id="pagination" class="pagination"></div>',
  `<div class="archive-cta"><a href="/blog/archive/">Browse the complete archive &mdash; every daily summary on one page</a> <span class="archive-count">(${blogTotalPages()} pages of summaries, ${SUMMARIES.length} posts)</span></div>
        <div id="pagination" class="pagination">${paginationHtml}</div>`
);

// Card/archive styling.
html = html.replace(
  '  </style>',
  `  .summary-card-title { font-size: 1.02rem; font-weight: 600; color: var(--text-primary); margin: 0.2rem 0 0; }
  .archive-cta { margin: 1.5rem auto 0.5rem; text-align: center; }
  .archive-cta a { color: var(--accent); font-weight: 600; }
  .archive-count { color: var(--text-muted); font-size: 0.85rem; }
  </style>`
);

// Embed the index for client-side year/month filtering. Blog listing pages do
// not render a chart, so no Chart.js bundle is injected here.
html = html.replace(
  '<body>',
  `<body>\n<script>const BLOG_INDEX = ${inlineJson(blogIndex)};</script>`
);

// Replace the fetch-based init with embedded-index filtering.
html = html.replace(
  '    // Static index: filters are wired in BlogList.astro.',
  `    (function initStaticFilters() {
      const yearSelect = document.getElementById('yearFilter');
      const monthSelect = document.getElementById('monthFilter');

      function populateMonths(year) {
        monthSelect.innerHTML = '<option value="">All Months</option>';
        monthSelect.disabled = !year;
        if (year) {
          const available = new Set(
            BLOG_INDEX.filter(i => i.date.startsWith(year)).map(i => i.date.slice(5, 7))
          );
          MONTHS.forEach((name, idx) => {
            const value = String(idx + 1).padStart(2, '0');
            if (!available.has(value)) return;
            const opt = document.createElement('option');
            opt.value = value;
            opt.textContent = name;
            monthSelect.appendChild(opt);
          });
        }
      }

      function applyFilter(push) {
        const y = yearSelect.value;
        const m = monthSelect.value;
        if (!y && !m) { window.location.href = '/blog/'; return; }
        const filtered = BLOG_INDEX.filter(i =>
          (!y || i.date.startsWith(y)) && (!m || i.date.slice(5, 7) === m)
        );
        if (!filtered.length) {
          document.getElementById('content').innerHTML = '<div class="error">No summaries found.</div>';
          document.getElementById('pagination').innerHTML = '';
          return;
        }
        renderSummaries(filtered);
        document.getElementById('pagination').innerHTML = '';
        if (push) {
          const url = new URL(window.location);
          url.searchParams.set('page', '1');
          if (y) url.searchParams.set('year', y); else url.searchParams.delete('year');
          if (m) url.searchParams.set('month', m); else url.searchParams.delete('month');
          window.history.pushState({}, '', url);
        }
      }

      const years = [...new Set(BLOG_INDEX.map(i => i.date.slice(0, 4)))].sort().reverse();
      years.forEach(y => {
        const opt = document.createElement('option');
        opt.value = y;
        opt.textContent = y;
        yearSelect.appendChild(opt);
      });

      yearSelect.addEventListener('change', () => { populateMonths(yearSelect.value); applyFilter(true); });
      monthSelect.addEventListener('change', () => applyFilter(true));

      const params = new URLSearchParams(window.location.search);
      if (params.get('year')) {
        yearSelect.value = params.get('year');
        populateMonths(yearSelect.value);
        if (params.get('month')) monthSelect.value = params.get('month');
        applyFilter(false);
      } else if (params.get('month')) {
        monthSelect.value = params.get('month');
        applyFilter(false);
      }
    })();`
);
---
<Fragment set:html={html} />
